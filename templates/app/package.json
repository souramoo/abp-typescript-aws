{
  "name": "@abp/template-app",
  "version": "0.1.0",
  "private": true,
  "description": "Deployable ABP application template (port of the ABP app startup template) for AWS Lambda",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx --tsconfig ../../tsconfig.json src/local.ts",
    "seed": "tsx --tsconfig ../../tsconfig.json src/seed.ts",
    "test": "vitest run --root ../.. templates/app",
    "deploy": "pnpm --filter @abp/infra deploy",
    "synth": "pnpm --filter @abp/infra synth"
  },
  "dependencies": {
    "@abp/core": "workspace:*",
    "@abp/aws-lambda": "workspace:*",
    "@abp/auth-jwt": "workspace:*",
    "@abp/ddd-domain": "workspace:*",
    "@abp/ddd-application": "workspace:*",
    "@abp/dynamodb": "workspace:*",
    "@abp/memory-db": "workspace:*",
    "@abp/caching": "workspace:*",
    "@abp/caching-dynamodb": "workspace:*",
    "@abp/distributed-locking": "workspace:*",
    "@abp/distributed-locking-dynamodb": "workspace:*",
    "@abp/blob-storing": "workspace:*",
    "@abp/blob-storing-aws": "workspace:*",
    "@abp/background-jobs": "workspace:*",
    "@abp/background-jobs-aws": "workspace:*",
    "@abp/background-workers": "workspace:*",
    "@abp/event-bus": "workspace:*",
    "@abp/event-bus-aws": "workspace:*",
    "@abp/emailing": "workspace:*",
    "@abp/emailing-aws": "workspace:*",
    "@abp/sms": "workspace:*",
    "@abp/sms-aws": "workspace:*",
    "@abp/localization": "workspace:*",
    "@abp/authorization": "workspace:*",
    "@abp/settings": "workspace:*",
    "@abp/features": "workspace:*",
    "@abp/multi-tenancy": "workspace:*",
    "@abp/multi-tenancy-abstractions": "workspace:*",
    "@abp/security": "workspace:*",
    "@abp/auditing": "workspace:*",
    "@abp/data": "workspace:*",
    "@abp/uow": "workspace:*",
    "@abp/guids": "workspace:*",
    "@abp/timing": "workspace:*",
    "@abp/json": "workspace:*",
    "@abp/validation": "workspace:*",
    "@abp/object-mapping": "workspace:*",
    "@abp/object-extending": "workspace:*",
    "@abp/users": "workspace:*",
    "@abp/identity": "workspace:*",
    "@abp/permission-management": "workspace:*",
    "@abp/setting-management": "workspace:*",
    "@abp/feature-management": "workspace:*",
    "@abp/tenant-management": "workspace:*",
    "@abp/audit-logging": "workspace:*",
    "@abp/background-jobs-store": "workspace:*",
    "@abp/account": "workspace:*",
    "zod": "^4.6.5",
    "@abp/http": "workspace:*",
    "@aws-sdk/client-secrets-manager": "^3.1133.0"
  },
  "devDependencies": {
    "@abp/test-base": "workspace:*",
    "@types/aws-lambda": "^8.10.163",
    "tsx": "^4.23.13",
    "aws-sdk-client-mock": "^4.1.0"
  }
}
