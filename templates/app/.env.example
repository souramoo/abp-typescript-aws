# Environment variables of the template application. Any configuration key can be set as
# ABP__<Section>__<Key> (the .NET "__" separator); the values below are what the CDK stack sets on Lambda.

# Development | Staging | Production (selects appsettings.<env>.json)
ABP_ENVIRONMENT=Development
# pretty | json
ABP_LOG_FORMAT=pretty
ABP_LOG_LEVEL=Information

# DynamoDb (default, AWS) | Memory (in-process, `pnpm dev` and tests)
ABP__App__Database=Memory
ABP__App__SelfUrl=http://localhost:3000

# DynamoDB single table (CDK output "TableName"); with `ABP_DEV_DB=dynamodb-local` it is created on start
ABP__ConnectionStrings__Default=
# ABP_DEV_DB=dynamodb-local
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
# AWS_REGION=eu-west-2

# JWT: an HMAC key (>= 32 bytes) for development, or the Secrets Manager ARN the stack creates
ABP__Auth__Jwt__SigningKey=
ABP__Auth__Jwt__SigningKeySecretArn=
ABP__Auth__Jwt__Issuer=TemplateApp
ABP__Auth__Jwt__Audience=TemplateApp

# AWS providers (set by the stack)
ABP__BlobStoring__Aws__BucketName=
ABP__BackgroundJobs__Aws__QueueUrl=
ABP__EventBus__Aws__TopicArn=
ABP__EventBus__Aws__QueueUrl=
# ABP__Emailing__Aws__Region=
# ABP__Sms__Aws__Region=

PORT=3000
